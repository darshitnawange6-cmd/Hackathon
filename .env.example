# ==============================================================================
# VOCAGUIDE – PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# - Copy this file to .env for local testing: cp .env.example .env
# - For Vercel: Set FRONTEND variables in the Vercel Project Settings.
# - For Render: Set BACKEND, SUPABASE, and AI variables in the Render Dashboard.
# - NEVER commit live secrets or API keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Safe to expose publicly in client build bundle.
# Leave blank when using same-origin proxy or Vercel rewrites.
# In production on Vercel, set this to your live Render backend URL:
# Example: https://vocaguide-api.onrender.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render Environment Variables)
# ------------------------------------------------------------------------------
# Render dynamically provides PORT (typically 10000).
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins:
# Use "*" for open access, or comma-separated list of allowed frontend domains.
# Example: https://vocaguide.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Optional: Path for local SQLite storage (falls back to backend/campus.db)
# On Render with persistent disk: /var/data/campus.db
DATABASE_PATH=

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & KNOWLEDGE BASE (Render Environment Variables)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Dashboard -> Project Settings -> API.
# Note: Keep the key on the backend ONLY. Never expose in frontend client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ------------------------------------------------------------------------------
# 4. AI LLM PROVIDERS (Render Environment Variables)
# ------------------------------------------------------------------------------
# Active Provider: "demo" (default offline engine, zero keys required),
#                  "gemini" (Google Gemini 1.5/2.0),
#                  "openai" (GPT-4o / GPT-4o-mini),
#                  "groq" (Llama 3.3 70B fast inference)
AI_PROVIDER=demo

# Cloud AI API Keys (Optional - activates cloud LLM reasoning when provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional model override (defaults automatically if left blank)
# - For Gemini: gemini-1.5-flash or gemini-2.0-flash
# - For OpenAI: gpt-4o-mini or gpt-4o
# - For Groq: llama-3.3-70b-versatile
MODEL_NAME=
